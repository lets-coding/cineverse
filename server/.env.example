# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=CineVerse
CLIENT_URL=http://localhost:5173

# Database URL
# For local SQLite development (zero-setup):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Neon / Supabase / Render):
# DATABASE_URL="postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET=cineverse_super_secret_jwt_key_min_32_characters_long_2026
JWT_EXPIRES_IN=7d

# Storage & Upload Configuration (for Cloudflare R2 / S3 / Local)
STORAGE_PROVIDER=local
STORAGE_BUCKET=cineverse-media
STORAGE_PUBLIC_URL=http://localhost:5000/uploads
